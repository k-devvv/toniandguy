{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toniandguy-bengaluru",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "build": { "command": "npm run build", "watch_dir": ["public", "scripts"] },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "toniandguybangalore.in",
      "custom_domain": true
    },
    {
      "pattern": "www.toniandguybangalore.in",
      "custom_domain": true
    }
  ]
}

